# ============================================================================
# Copy to .env and fill in your own keys. Read by the Python harness via
# python-dotenv (and by the Makefile via `source`).
# ============================================================================

# --- LLM API keys ---
# Models are routed via OpenRouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only required if you run OpenAI-hosted models (gpt-*). Leave blank otherwise.
OPENAI_API_KEY=

# --- MySQL (BEAVER databases) ---
# Runs in a container `beaver-mysql` (mysql:9.3), host port 3307.
# Data lives in the named volume `beaver-mysql-data` (persists across restarts).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=beaver
MYSQL_PASSWORD=beaver
